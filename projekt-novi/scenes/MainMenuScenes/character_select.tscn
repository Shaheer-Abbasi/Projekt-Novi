[sub_resource type="Resource" id="Resource_8wdgy"]
script = ExtResource("2_ngn8s")
story = "Living happily ever after with the love of her life 
under the city lights, that was stripped away from 
her due to corrupt Corporations."
tile = SubResource("AtlasTexture_2ui3u")
illustration = SubResource("AtlasTexture_56noq")
sprite = SubResource("AtlasTexture_la7ph")
sprite_shadow = SubResource("AtlasTexture_d2suj")
ultimate_bar = SubResource("AtlasTexture_6jep6")
ultimate_name = "Bridal Cries"
ultimate_text = "Vow lets out her inner sorrow causing a
massive EMP wave to emit from her."
ability1_icon = SubResource("AtlasTexture_w6u4x")
ability1_name = "Fan Burst"
ability1_text = "Vow swings her sword making multiple slashes
at once, resulting to a wide slash."
ability2_icon = SubResource("AtlasTexture_ra8v2")
ability2_name = "EMP Wave"
ability2_text = "Vow uses her Robotic arm to cause a small
EMP Wave that causes Damage."
ability3_icon = SubResource("AtlasTexture_vvly5")
ability3_name = "Bouquet Throw"
ability3_text = "Vow throws a Bouquet damaging enemies from
a distance."

[sub_resource type="Resource" id="Resource_reaper"]
script = ExtResource("2_ngn8s")
display_name = "Reaper"
story = "A test subject built for one job: assassination.
She slipped out of Projekt Novi with the scythe they
gave her, and now she hunts the ones who made it."
character_data = ExtResource("10_reaper")
tile = ExtResource("11_reaper")
illustration = ExtResource("12_reaper")
illustration_position = Vector2(140, 200)
sprite = ExtResource("13_reaper")
ultimate_name = "Grim Harvest"
ultimate_text = "A huge scythe spin around her. Enemies left
under 25% HP are finished off instantly."
ability1_name = "Reap"
ability1_text = "A wide scythe sweep. Every enemy caught
in it heals her a little."
ability2_name = "Shadow Step"
ability2_text = "Blinks to the cursor, cutting every enemy
along the way. She can't be hit mid-step."
ability3_name = "Death Mark"
ability3_text = "Marks an enemy: it takes +50% damage. If it
dies marked, it bursts and hurts those nearby."

